#!/usr/bin/env python3

# Define a central function to handle loss states to keep code DRY (Don't Repeat Yourself)
def game_over(reason):
    print(f"\n{reason}")
    print("--- GAME OVER ---")

# Define the winning outcome node
def victory():
    print("\nYou open the glowing chest and claim the forgotten treasure!")
    print("--- VICTORY! YOU WIN! ---")

# Function representing the bridge location branch
def bridge_path():
    print("\nYou stand before a rickety wooden bridge across a canyon.")
    # Clean input by stripping whitespace and lowering case to avoid formatting bugs
    choice = input("Do you cross or turn back? (cross/back): ").strip().lower()
    
    if choice == "cross":
        victory()  # Outcome 1: Victory
    else:
        game_over("The edge crumbles while you hesitate!")  # Outcome 2: Defeat

# Entry point function to handle initial story choice
def start_game():
    print("--- THE ADVENTURE BEGINS ---")
    print("You are standing at a fork in a dark forest.")
    choice = input("Do you take the 'left' bridge or 'right' path?: ").strip().lower()
    
    # Route player execution based on structural choice
    if choice == "left":
        bridge_path()
    else:
        game_over("You walked straight into a monster's den!")  # Outcome 3: Defeat

